# Sellerboard UK breakdown -> Power BI: once a day at 13:00 (server time), last 4 full days.
# Set SELLERBOARD_WINDOW_DAYS=4 in .env. Each day the window overlaps the 3 days before: rows
# already in Power BI are skipped (insert-only), so the overlap never creates duplicates.
# Install with `crontab -e`, replacing any older Sellerboard line (e.g. an hourly one).
# Use absolute paths: cron's PATH is minimal (`which uv` shows uv's path).
# Each run appends one summary line to logs/cron.log; details go to logs/importer.log.
MAILTO=""
0 13 * * * cd /data/cron/UK-Product-Breakdown-Data && /root/.local/bin/uv run --no-sync python run.py --quiet >> logs/cron-output.log 2>&1
