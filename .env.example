# Copy to .env and fill in. .env is git-ignored; never commit real passwords.

# --- Local Docker MySQL (staging) --------------------------------------------
SELLERBOARD_DB_HOST=127.0.0.1
# 3310 was free when this project was set up (3306 = Windows MySQL80, 3308/3309 = other containers).
SELLERBOARD_DB_PORT=3310
SELLERBOARD_DB_NAME=sellerboard
SELLERBOARD_DB_USER=sellerboard_app
SELLERBOARD_DB_PASSWORD=<local-app-password>
# Used only by Docker to initialise the container, and by the integration tests
# to create and drop throwaway sbtest_* databases.
SELLERBOARD_DB_ROOT_PASSWORD=<local-root-password>

# --- Sellerboard input and schedule ------------------------------------------
# Exports go through data/incoming/ -> data/processed/ or data/failed/.
# SELLERBOARD_DATA_DIR=/data/cron/sellerboard-uk-breakdown-cron/data
SELLERBOARD_FILE_PATTERN=Econour_Dashboard_by_product_*.xlsx
# Days per run (the last N full days) and how far a missed run may catch up.
SELLERBOARD_WINDOW_DAYS=4
SELLERBOARD_MAX_CATCHUP_DAYS=31
LOG_LEVEL=INFO
# Optional: comma-separated marketplace allow-list (defaults to the marketplaces
# held by Uk_breakdown_data). Example for UK only:
# SELLERBOARD_ALLOWED_MARKETPLACES=Amazon.co.uk

# --- Sellerboard sign-in (server without a screen) ------------------------------
# Used by `run.py --login` on a server, and automatically when the saved session
# has expired: one attempt; after a refused attempt, scheduled runs wait 24 hours.
SELLERBOARD_LOGIN_EMAIL=<sellerboard-email>
SELLERBOARD_LOGIN_PASSWORD=<sellerboard-password>

# --- Power BI destination (remote; separate credentials) -----------------------
# Needs SELECT + INSERT on powerbidb.Uk_breakdown_data only (the sync never updates or deletes).
# A dedicated least-privilege user is recommended.
POWERBI_DB_HOST=13.126.54.249
POWERBI_DB_PORT=3306
POWERBI_DB_NAME=powerbidb
POWERBI_DB_USER=<powerbi-writer-user>
POWERBI_DB_PASSWORD=<powerbi-writer-password>
POWERBI_DB_TABLE=Uk_breakdown_data
# Optional: path to a CA certificate to require TLS to the Power BI server.
# POWERBI_DB_SSL_CA=

# --- Second account: premiumcarproduct (US) -> run with:  run.py --us-premium ---
# Each US_ line replaces the same setting without US_ for that run; passwords and the
# Sellerboard login are shared. Own data/us + logs/us folders, shared session.
# The US job replaces the downloaded days (dates x marketplaces) in one transaction.
US_SELLERBOARD_ACCOUNT=premiumcarproduct@gmail.com
US_POWERBI_DB_TABLE=Sellerboard_breakdown_data_2024
US_SELLERBOARD_ALLOWED_MARKETPLACES=Amazon.com,Amazon.ca,Amazon.com.mx,Non-Amazon
US_SELLERBOARD_FILE_PATTERN=EcoNour_Dashboard_by_product_*.xlsx
US_SELLERBOARD_WINDOW_DAYS=4
